@page "/login"
@using BlazorUserManagement.Data
@using BlazorUserManagement.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>登入 - 使用者管理系統</PageTitle>

<div class="login-container">
    <MudContainer MaxWidth="MaxWidth.Xs" Class="py-8">
        <MudPaper Class="pa-8" Elevation="3">
            <div class="text-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" Color="Color.Primary"></MudIcon>
                <MudText Typo="Typo.H4" Class="mt-3">使用者管理系統</MudText>
                <MudText Typo="Typo.Body2" Color="Color.TextSecondary">請輸入帳號密碼登入</MudText>
            </div>

            <EditForm Model="@loginRequest" OnSubmit="@HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField 
                    @bind-Value="loginRequest.Username"
                    Label="使用者名稱"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Class="mb-4"
                    Placeholder="輸入使用者名稱"
                    Disabled="@isLoading">
                </MudTextField>
                <MudTextField 
                    @bind-Value="loginRequest.Password"
                    Label="密碼"
                    InputType="@passwordInput"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Class="mb-4"
                    Placeholder="輸入密碼"
                    Disabled="@isLoading"
                    Adornment="Adornment.End"
                    AdornmentIcon="@passwordInputIcon"
                    OnAdornmentClick="@TogglePasswordVisibility">
                </MudTextField>

                <ValidationSummary Class="mb-4" />

                <MudButton 
                    ButtonType="ButtonType.Submit"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth="true"
                    Size="Size.Large"
                    Class="mb-3"
                    Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"></MudProgressCircular>
                        <MudText Class="ms-2">登入中...</MudText>
                    }
                    else
                    {
                        <MudText>登入</MudText>
                    }
                </MudButton>

                <MudDivider Class="my-4"></MudDivider>

                <MudText Typo="Typo.Body2" Align="Align.Center" Color="Color.TextSecondary" Class="mb-3">
                    測試帳號
                </MudText>
                <MudList>
                    <MudListItem>
                        <MudText Typo="Typo.Caption">帳號: <strong>admin</strong> / 密碼: <strong>admin123</strong></MudText>
                    </MudListItem>
                    <MudListItem>
                        <MudText Typo="Typo.Caption">帳號: <strong>user1</strong> / 密碼: <strong>admin123</strong></MudText>
                    </MudListItem>
                </MudList>
            </EditForm>
        </MudPaper>
    </MudContainer>
</div>

<style>
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>

@code {
    private LoginRequest loginRequest = new();
    private bool isLoading = false;
    private bool showPassword = false;

    private InputType passwordInput => showPassword ? InputType.Text : InputType.Password;
    private string passwordInputIcon => showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override void OnInitialized()
    {
        // 若已登入，導向主頁
        if (IsLoggedIn())
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(loginRequest);

            if (response.Success)
            {
                // 儲存 Token 到 LocalStorage (需實作)
                Snackbar.Add($"歡迎 {response.User.FullName ?? response.User.Username}！", Severity.Success);
                
                // 延遲後導向主頁
                await Task.Delay(1000);
                Navigation.NavigateTo("/", replace: true);
            }
            else
            {
                Snackbar.Add(response.Message, Severity.Error);
                loginRequest.Password = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"登入失敗: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private bool IsLoggedIn()
    {
        // 此處應檢查 LocalStorage 或 Session 中是否存在有效的 Token
        // 可使用 Blazored.LocalStorage 套件
        return false;
    }
}

@page "/demo/shipment"
@attribute [Authorize]
@using System.Globalization
@using BlazorUserManagement.Data.Cms
@using BlazorUserManagement.Models
@inject BaseNotifier Notifier
@inject BaseDialogService Dialog
@inject CmsDataService CmsData
@inject IBaseParameterProvider ParameterProvider

@*
    範例畫面：寄件登記
    以底層元件組成完整的輸入畫面，儲存後顯示「登記內容確認」供核對輸入結果
    資料存放在測試資料暫存表 CMSData (PageName = ShipmentRegister)
*@

<PageTitle>寄件登記 - 使用者管理系統</PageTitle>
<SectionContent SectionName="breadcrumb">郵件作業 &gt; 寄件登記（範例畫面）</SectionContent>

<div class="msg msg-info">此為範例畫面，登記資料存放在測試資料暫存表 CMSData（PageName = @ShipmentForm.CmsPageName）。</div>

<EditForm Model="form" OnValidSubmit="SaveAsync" class="base-keyboard-nav">
    <DataAnnotationsValidator />

    <div class="section-title">寄件人</div>
    <div class="base-field-grid">
        <BaseField Label="姓名" Required="true">
            <BaseTextBox @bind-Value="form.SenderName" MaxLength="50" AutoNext="false" />
        </BaseField>
        <BaseField Label="寄件方式">
            <BaseRadioGroup @bind-Value="form.SendMethod" Options="sendMethodOptions" />
        </BaseField>
        <BaseField Label="手機">
            <BaseMobile @bind-Value="form.SenderMobile" />
        </BaseField>
        <BaseField Label="電話">
            <BaseTelephone @bind-Value="form.SenderTel" />
        </BaseField>
        <BaseField Label="地址" Required="true" ColSpan="2">
            <BaseAddress @bind-County="form.SenderCounty" @bind-District="form.SenderDistrict"
                         @bind-ZipCode="form.SenderZipCode" @bind-Detail="form.SenderAddress" />
        </BaseField>
    </div>

    <div class="section-title">收件人</div>
    <div class="base-field-grid">
        <BaseField Label="姓名" Required="true">
            <BaseTextBox @bind-Value="form.ReceiverName" MaxLength="50" AutoNext="false" />
        </BaseField>
        <BaseField Label="手機" Required="true">
            <BaseMobile @bind-Value="form.ReceiverMobile" />
        </BaseField>
        <BaseField Label="地址" Required="true" ColSpan="2">
            <BaseAddress @bind-County="form.ReceiverCounty" @bind-District="form.ReceiverDistrict"
                         @bind-ZipCode="form.ReceiverZipCode" @bind-Detail="form.ReceiverAddress" />
        </BaseField>
    </div>

    <div class="section-title">郵件資訊</div>
    <div class="base-field-grid">
        <BaseField Label="郵件種類" Required="true">
            <BaseParameterSelect @bind-Value="form.MailType" SetItem="MAIL_TYPE" />
        </BaseField>
        <BaseField Label="付款方式" Required="true">
            <BaseParameterSelect @bind-Value="form.PayType" SetItem="PAY_TYPE" />
        </BaseField>
        <BaseField Label="件數" Required="true">
            <BaseNumeric @bind-Value="form.Quantity" IntegerDigits="2" Min="1" Width="100px" />
        </BaseField>
        <BaseField Label="重量（公斤）" Required="true">
            <BaseNumeric @bind-Value="form.WeightKg" IntegerDigits="2" DecimalDigits="3" Min="0" Width="120px" Placeholder="例：1.25" />
        </BaseField>
        <BaseField Label="保價金額（元）">
            <BaseNumeric @bind-Value="form.InsuredAmount" IntegerDigits="7" DecimalDigits="0" Min="0" Width="140px" Placeholder="選填" />
        </BaseField>
        <BaseField Label="寄件日期" Required="true">
            <BaseDatePicker @bind-Value="form.ShipDate" Roc="true" Min="DateTime.Today" />
        </BaseField>
        <BaseField Label="指定送達期間" ColSpan="2">
            <BaseDateRange @bind-StartValue="form.DeliveryStart" @bind-EndValue="form.DeliveryEnd" MaxMonths="1" Roc="true" />
        </BaseField>
        <BaseField Label="簽收" ColSpan="2">
            <BaseCheckBox @bind-Value="form.NeedSignature" Label="需收件人簽收" />
        </BaseField>
        <BaseField Label="備註" ColSpan="2">
            <BaseTextArea @bind-Value="form.Remark" MaxLength="200" Rows="2" />
        </BaseField>
    </div>

    <div class="base-button-bar">
        <BaseButton Text="儲存" Kind="BaseButtonKind.Primary" Icon="BaseIcon.Save" ButtonType="ButtonType.Submit" />
        <BaseButton Text="重設" Icon="BaseIcon.Reset" OnClick="Reset" />
    </div>
</EditForm>

@if (confirmation is not null)
{
    <div class="section-title">登記內容確認（第 @confirmation.No 筆）</div>
    <table class="confirm-table">
        @foreach (var (label, value) in confirmation.Items)
        {
            <tr>
                <th>@label</th>
                <td>@value</td>
            </tr>
        }
    </table>
}

<div class="section-title">批次匯入</div>
<BaseFileUpload Accept=".csv" MaxFileSizeMB="2"
                TemplateUrl="templates/shipments-sample.csv"
                Hint="CSV 格式：寄件日期(民國),收件人姓名,收件人手機,收件人地址,件數,重量(公斤)，第一列為標題。任一列有誤時整批不匯入。"
                OnUpload="ImportAsync" />

<div class="section-title">已登記清單</div>
<BaseDataGrid Items="records" PageSize="10" ColumnWidths="60px 100px 1fr 120px 2fr 110px 60px 90px 110px 70px 110px">
    <Columns>
        <PropertyColumn Property="x => x.No" Title="編號" Align="Align.Center" />
        <TemplateColumn Title="寄件日期" Align="Align.Center" Context="r">@BaseDateFormat.ToRoc(r.ShipDate)</TemplateColumn>
        <PropertyColumn Property="x => x.ReceiverName" Title="收件人" />
        <PropertyColumn Property="x => x.ReceiverMobile" Title="手機" />
        <PropertyColumn Property="x => x.ReceiverAddress" Title="收件地址" />
        <PropertyColumn Property="x => x.MailTypeText" Title="郵件種類" />
        <PropertyColumn Property="x => x.Quantity" Title="件數" Align="Align.End" />
        <TemplateColumn Title="重量" Align="Align.End" Context="r">@BaseNumberFormat.Format(r.WeightKg, 3)</TemplateColumn>
        <TemplateColumn Title="保價金額" Align="Align.End" Context="r">@BaseNumberFormat.Format(r.InsuredAmount, 0)</TemplateColumn>
        <PropertyColumn Property="x => x.Source" Title="來源" Align="Align.Center" />
        <TemplateColumn Title="操作" Align="Align.Center" Context="r">
            <BaseButton Text="刪除" AccessKey="" Kind="BaseButtonKind.Danger" Icon="BaseIcon.Delete" OnClick="() => DeleteAsync(r)" />
        </TemplateColumn>
    </Columns>
</BaseDataGrid>

@code {
    private static readonly BaseOption<string>[] sendMethodOptions =
    [
        new("Counter", "臨櫃交寄"),
        new("Pickup", "到府收件"),
    ];

    private ShipmentForm form = NewForm();
    private List<ShipmentRecord> records = [];
    private Confirmation? confirmation;

    private record Confirmation(int No, List<(string Label, string Value)> Items);

    private static ShipmentForm NewForm() => new() { ShipDate = DateTime.Today };

    protected override Task OnInitializedAsync() => LoadRecordsAsync();

    /// <summary>
    /// 從 CMSData 讀取已登記的寄件
    /// </summary>
    private async Task LoadRecordsAsync()
    {
        var mailTypes = await ParameterProvider.GetOptionsAsync("MAIL_TYPE");
        var saved = await CmsData.ListAsync<ShipmentForm>(ShipmentForm.CmsPageName);

        records = saved.Select((r, i) => new ShipmentRecord(
            r.PKey,
            i + 1,
            r.Model.ShipDate ?? r.CreateDate.Date,
            r.Model.ReceiverName ?? string.Empty,
            r.Model.ReceiverMobile ?? string.Empty,
            BaseAddress.Format(r.Model.ReceiverCounty, r.Model.ReceiverDistrict, r.Model.ReceiverAddress),
            mailTypes.FirstOrDefault(o => o.Value == r.Model.MailType)?.Text ?? r.Model.MailType ?? string.Empty,
            r.Model.Quantity ?? 0,
            r.Model.WeightKg ?? 0,
            r.Model.InsuredAmount,
            r.Model.Source)).ToList();
    }

    private void Reset()
    {
        form = NewForm();
        confirmation = null;
    }

    private bool saving;

    private async Task SaveAsync()
    {
        // 儲存中忽略重複送出 (避免連點造成重複新增)
        if (saving)
        {
            return;
        }

        saving = true;
        try
        {
            await SaveCoreAsync();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveCoreAsync()
    {
        var mailTypeText = await GetParameterTextAsync("MAIL_TYPE", form.MailType);
        var payTypeText = await GetParameterTextAsync("PAY_TYPE", form.PayType);

        form.Source = ShipmentForm.SourceScreen;
        await CmsData.SaveAsync(ShipmentForm.CmsPageName, form);
        await LoadRecordsAsync();
        var no = records.Count;

        var receiverAddress = BaseAddress.Format(form.ReceiverCounty, form.ReceiverDistrict, form.ReceiverAddress);

        // 以「人看得懂」的格式列出實際收到的內容，供核對輸入是否正確
        confirmation = new Confirmation(no,
        [
            ("寄件人", form.SenderName!),
            ("寄件方式", sendMethodOptions.First(o => o.Value == form.SendMethod).Text),
            ("寄件人手機", form.SenderMobile ?? "（未填）"),
            ("寄件人電話", form.SenderTel ?? "（未填）"),
            ("寄件人地址", $"{form.SenderZipCode} {BaseAddress.Format(form.SenderCounty, form.SenderDistrict, form.SenderAddress)}"),
            ("收件人", form.ReceiverName!),
            ("收件人手機", form.ReceiverMobile!),
            ("收件人地址", $"{form.ReceiverZipCode} {receiverAddress}"),
            ("郵件種類", mailTypeText),
            ("付款方式", payTypeText),
            ("件數", $"{form.Quantity} 件"),
            ("重量", $"{BaseNumberFormat.Format(form.WeightKg, 3)} 公斤"),
            ("保價金額", form.InsuredAmount is null ? "（未保價）" : $"NT$ {BaseNumberFormat.Format(form.InsuredAmount, 0)}"),
            ("寄件日期", $"{BaseDateFormat.ToRoc(form.ShipDate)}（西元 {form.ShipDate:yyyy/MM/dd}）"),
            ("指定送達期間", form.DeliveryStart is null && form.DeliveryEnd is null
                ? "（未指定）"
                : $"{BaseDateFormat.ToRoc(form.DeliveryStart)} ～ {BaseDateFormat.ToRoc(form.DeliveryEnd)}"),
            ("簽收", form.NeedSignature ? "需簽收" : "不需簽收"),
            ("備註", string.IsNullOrWhiteSpace(form.Remark) ? "（無）" : form.Remark),
        ]);

        Notifier.Success($"第 {no} 筆寄件已登記");
        form = NewForm();
    }

    private async Task<BaseUploadResult> ImportAsync(IReadOnlyList<BaseUploadFile> files)
    {
        var messages = new List<string>();
        var imported = new List<ShipmentForm>();

        // 先檢查全部檔案，任一列有誤時整批不匯入，避免部分匯入造成資料不一致
        foreach (var file in files)
        {
            var (rows, errors) = ShipmentCsvParser.Parse(file.Content, DateTime.Today);
            if (errors.Count > 0)
            {
                return BaseUploadResult.Fail([$"{file.Name} 有 {errors.Count} 個錯誤，整批未匯入：", .. errors]);
            }

            imported.AddRange(rows.Select(ShipmentForm.FromImport));
            messages.Add($"{file.Name}：匯入 {rows.Count} 筆");
        }

        await CmsData.AddRangeAsync(ShipmentForm.CmsPageName, imported);
        await LoadRecordsAsync();
        return BaseUploadResult.Ok([.. messages, $"共匯入 {imported.Count} 筆（郵件種類預設為普通包裹）"]);
    }

    private async Task DeleteAsync(ShipmentRecord record)
    {
        if (!await Dialog.ConfirmAsync($"確認要刪除第 {record.No} 筆（收件人：{record.ReceiverName}）嗎？", "刪除確認", "刪除"))
        {
            return;
        }

        await CmsData.DeleteAsync(record.PKey);
        await LoadRecordsAsync();
        Notifier.Success("已刪除");
    }

    private async Task<string> GetParameterTextAsync(string setItem, string? code)
    {
        var options = await ParameterProvider.GetOptionsAsync(setItem);
        return options.FirstOrDefault(o => o.Value == code)?.Text ?? code ?? string.Empty;
    }
}

@inherits LayoutComponentBase

<BaseProviders />

<!-- ========== 頁首：Logo / 系統名稱 / 登入者 ========== -->
<header class="sys-header">
    <div class="sys-logo">
        @* 可置換為公司 Logo 圖片，例如 <img src="images/logo.png" alt="公司名稱" /> *@
        <span class="sys-logo-text">公司名稱</span>
    </div>
    <div class="sys-title">使用者管理系統</div>
    <div class="sys-user">
        <AuthorizeView>
            <span class="sys-user-name">@context.User.Identity?.Name - @context.User.FindFirstValue("FullName")</span>
        </AuthorizeView>
        <form action="Account/Logout" method="post" class="inline-form">
            <AntiforgeryToken />
            <button type="submit" class="sys-logout">登出</button>
        </form>
    </div>
</header>

<!-- ========== 麵包屑 (各頁以 SectionContent SectionName="breadcrumb" 設定) ========== -->
<div class="sys-breadcrumb">
    <span class="crumb-arrow">&#9658;</span>
    <SectionOutlet SectionName="breadcrumb" />
</div>

<div class="sys-body">
    <!-- ========== 左側樹狀選單 ========== -->
    <nav class="sys-menu">
        <NavMenu />
    </nav>

    <!-- ========== 主內容 ========== -->
    <main class="sys-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    發生未預期的錯誤。
    <a href="" class="reload">重新載入</a>
    <a class="dismiss">✕</a>
</div>

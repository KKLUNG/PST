@using BlazorUserManagement.Data
@using BlazorUserManagement.Services
@inject UserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true"></MudProgressLinear>
    <div class="d-flex justify-center align-center" style="min-height: 300px;">
        <MudProgressCircular Indeterminate="true"></MudProgressCircular>
    </div>
}
else
{
    <MudDialog>
        <DialogContent>
            <EditForm Model="@model" OnSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <MudTextField 
                    @bind-Value="model.Username"
                    Label="使用者名稱"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Class="mb-4"
                    ReadOnly="@(isEditMode)"
                    Disabled="@(isSubmitting)">
                </MudTextField>

                <MudTextField 
                    @bind-Value="model.Email"
                    Label="電子郵件"
                    InputType="InputType.Email"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Class="mb-4"
                    Disabled="@(isSubmitting)">
                </MudTextField>

                <MudTextField 
                    @bind-Value="model.FullName"
                    Label="姓名"
                    Variant="Variant.Outlined"
                    FullWidth="true"
                    Class="mb-4"
                    Disabled="@(isSubmitting)">
                </MudTextField>

                @if (!isEditMode)
                {
                    <MudTextField 
                        @bind-Value="model.Password"
                        Label="密碼"
                        InputType="@passwordInput"
                        Variant="Variant.Outlined"
                        FullWidth="true"
                        Class="mb-4"
                        Disabled="@(isSubmitting)"
                        HelperText="最少6個字元"
                        Adornment="Adornment.End"
                        AdornmentIcon="@passwordInputIcon"
                        OnAdornmentClick="@TogglePasswordVisibility">
                    </MudTextField>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        若要變更密碼，請輸入新密碼。若保留空白，則密碼保持不變。
                    </MudAlert>
                    <MudTextField 
                        @bind-Value="model.Password"
                        Label="新密碼 (選填)"
                        InputType="@passwordInput"
                        Variant="Variant.Outlined"
                        FullWidth="true"
                        Class="mb-4"
                        Disabled="@(isSubmitting)"
                        HelperText="若要變更密碼，輸入最少6個字元的新密碼"
                        Adornment="Adornment.End"
                        AdornmentIcon="@passwordInputIcon"
                        OnAdornmentClick="@TogglePasswordVisibility">
                    </MudTextField>
                }

                <MudCheckBox 
                    @bind-Checked="model.IsActive"
                    Label="啟用此使用者"
                    Disabled="@(isSubmitting)">
                </MudCheckBox>

                <ValidationSummary Class="mt-4 mb-4" />

                <MudDivider Class="my-6"></MudDivider>

                <div class="d-flex justify-end gap-4">
                    <MudButton 
                        ButtonType="ButtonType.Button"
                        Variant="Variant.Text"
                        OnClick="@Cancel"
                        Disabled="@(isSubmitting)">
                        取消
                    </MudButton>
                    <MudButton 
                        ButtonType="ButtonType.Submit"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Disabled="@(isSubmitting)">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"></MudProgressCircular>
                            <MudText Class="ms-2">@(isEditMode ? "更新中..." : "新增中...")</MudText>
                        }
                        else
                        {
                            <MudText>@(isEditMode ? "更新" : "新增")</MudText>
                        }
                    </MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>
}

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public int? UserId { get; set; }

    private UserCreateEditRequest model = new();
    private bool isLoading = false;
    private bool isSubmitting = false;
    private bool isEditMode = false;
    private bool showPassword = false;

    private InputType passwordInput => showPassword ? InputType.Text : InputType.Password;
    private string passwordInputIcon => showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        if (UserId.HasValue)
        {
            // 編輯模式
            isEditMode = true;
            isLoading = true;
            try
            {
                var user = await UserService.GetUserByIdAsync(UserId.Value);
                model.Username = user.Username;
                model.Email = user.Email;
                model.FullName = user.FullName;
                model.IsActive = user.IsActive;
                model.Password = string.Empty; // 編輯時密碼欄位為空
            }
            catch (Exception ex)
            {
                Snackbar.Add($"載入使用者資料失敗: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            // 新增模式
            isEditMode = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            if (isEditMode)
            {
                // 編輯使用者
                await UserService.UpdateUserAsync(UserId.Value, model);
                Snackbar.Add("使用者已更新", Severity.Success);
            }
            else
            {
                // 新增使用者
                if (string.IsNullOrWhiteSpace(model.Password))
                {
                    Snackbar.Add("新增使用者必須設定密碼", Severity.Error);
                    isSubmitting = false;
                    return;
                }

                await UserService.CreateUserAsync(model);
                Snackbar.Add("使用者已新增", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"操作失敗: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
}

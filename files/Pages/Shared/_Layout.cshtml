@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var fullName = User.FindFirstValue("FullName");
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 使用者管理系統</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ========== 頁首：Logo / 系統名稱 / 登入者 ========== -->
    <header class="sys-header">
        <div class="sys-logo">
            @* 可置換為公司 Logo 圖片，例如 <img src="~/images/logo.png" alt="公司名稱" /> *@
            <span class="sys-logo-text">公司名稱</span>
        </div>
        <div class="sys-title">使用者管理系統</div>
        <div class="sys-user">
            <span class="sys-user-name">@User.Identity?.Name@(string.IsNullOrEmpty(fullName) ? "" : $" - {fullName}")</span>
            <form method="post" asp-page="/Account/Logout" class="inline-form">
                <button type="submit" class="btn btn-small">登出</button>
            </form>
        </div>
    </header>

    <!-- ========== 麵包屑 ========== -->
    <div class="sys-breadcrumb">
        <span class="crumb-arrow">&#9658;</span>
        <span>@(ViewData["Breadcrumb"] ?? ViewData["Title"])</span>
    </div>

    <div class="sys-body">
        <!-- ========== 左側樹狀選單 ========== -->
        <nav class="sys-menu">
            <ul class="tree">
                <li class="tree-leaf @(currentPage == "/Index" ? "active" : "")">
                    <a asp-page="/Index">首頁</a>
                </li>
                <li>
                    <details open>
                        <summary>系統管理</summary>
                        <ul>
                            <li class="tree-leaf @(currentPage == "/Users/Index" ? "active" : "")">
                                <a asp-page="/Users/Index">使用者查詢</a>
                            </li>
                            <li class="tree-leaf @(currentPage == "/Users/Edit" ? "active" : "")">
                                <a asp-page="/Users/Edit">使用者新增</a>
                            </li>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>

        <!-- ========== 主內容 ========== -->
        <main class="sys-main">
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="msg msg-@messageType">@message</div>
            }
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model IndexModel
@{
    ViewData["Title"] = "首頁";
}

<table class="query-table">
    <tr>
        <th>登入帳號</th>
        <td>@User.Identity?.Name</td>
        <th>姓名</th>
        <td>@User.FindFirstValue("FullName")</td>
    </tr>
</table>

<div class="section-title">系統功能</div>
<ul class="link-list">
    <li><a asp-page="/Users/Index">使用者查詢</a>：依帳號、電子郵件、姓名、狀態查詢使用者，並可編輯或刪除</li>
    <li><a asp-page="/Users/Edit">使用者新增</a>：建立新的使用者帳號</li>
</ul>

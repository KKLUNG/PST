@page
@model ErrorModel
@{
    ViewData["Title"] = "系統錯誤";
    Layout = "_LoginLayout";
}

<div class="login-box">
    <div class="login-box-title">系統錯誤</div>
    <div class="login-box-body">
        <p>處理您的要求時發生錯誤，請稍後再試或聯絡系統管理員。</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="text-muted">錯誤代碼：@Model.RequestId</p>
        }
        <div class="button-bar">
            <a class="btn" asp-page="/Index">回首頁</a>
        </div>
    </div>
</div>

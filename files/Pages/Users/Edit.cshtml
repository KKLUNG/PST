@page "{id:int?}"
@model BlazorUserManagement.Pages.Users.EditModel
@{
    var title = Model.IsEditMode ? "使用者編輯" : "使用者新增";
    ViewData["Title"] = title;
    ViewData["Breadcrumb"] = $"系統管理 > {title}";
}

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <table class="query-table">
        <tr>
            <th><label asp-for="Input.Username">帳號</label><span class="required">*</span></th>
            <td>
                @if (Model.IsEditMode)
                {
                    <input asp-for="Input.Username" type="text" readonly />
                }
                else
                {
                    <input asp-for="Input.Username" type="text" />
                }
                <span asp-validation-for="Input.Username"></span>
            </td>
            <th><label asp-for="Input.Email">電子郵件</label><span class="required">*</span></th>
            <td>
                <input asp-for="Input.Email" type="email" />
                <span asp-validation-for="Input.Email"></span>
            </td>
        </tr>
        <tr>
            <th><label asp-for="Input.FullName">姓名</label></th>
            <td>
                <input asp-for="Input.FullName" type="text" />
                <span asp-validation-for="Input.FullName"></span>
            </td>
            <th><label asp-for="Input.IsActive">狀態</label></th>
            <td>
                <label><input asp-for="Input.IsActive" /> 啟用此使用者</label>
                <span asp-validation-for="Input.IsActive"></span>
            </td>
        </tr>
        <tr>
            <th>
                <label asp-for="Input.Password">@(Model.IsEditMode ? "新密碼" : "密碼")</label>
                @if (!Model.IsEditMode)
                {
                    <span class="required">*</span>
                }
            </th>
            <td colspan="3">
                <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                <span class="text-muted">
                    @(Model.IsEditMode ? "若要變更密碼請輸入新密碼（至少 6 個字元），留空則維持原密碼" : "至少 6 個字元")
                </span>
                <span asp-validation-for="Input.Password"></span>
            </td>
        </tr>
    </table>

    <div class="button-bar">
        <button type="submit" class="btn" accesskey="s">存檔(S)</button>
        <a class="btn" asp-page="/Users/Index" accesskey="r">返回(R)</a>
    </div>
</form>

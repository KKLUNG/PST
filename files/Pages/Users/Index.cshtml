@page
@model BlazorUserManagement.Pages.Users.IndexModel
@{
    ViewData["Title"] = "使用者查詢";
    ViewData["Breadcrumb"] = "系統管理 > 使用者查詢";
}

<!-- ========== 查詢條件 ========== -->
<form method="get">
    <table class="query-table">
        <tr>
            <th><label asp-for="Query.Username">帳號</label></th>
            <td><input asp-for="Query.Username" type="text" /></td>
            <th><label asp-for="Query.Email">電子郵件</label></th>
            <td><input asp-for="Query.Email" type="text" /></td>
        </tr>
        <tr>
            <th><label asp-for="Query.FullName">姓名</label></th>
            <td><input asp-for="Query.FullName" type="text" /></td>
            <th><label asp-for="Query.IsActive">狀態</label></th>
            <td>
                <select asp-for="Query.IsActive">
                    <option value="">－ 全部 －</option>
                    <option value="true">啟用</option>
                    <option value="false">停用</option>
                </select>
            </td>
        </tr>
    </table>
    <div class="button-bar">
        <button type="submit" class="btn" accesskey="q">查詢(Q)</button>
        <a class="btn" asp-page="/Users/Index" accesskey="c">清除(C)</a>
    </div>
</form>

<!-- ========== 查詢結果 ========== -->
<div class="grid-toolbar">
    <span>共 <strong>@Model.Users.Count</strong> 筆</span>
    <a class="btn" asp-page="/Users/Edit" accesskey="a">新增(A)</a>
</div>

<div class="grid-wrapper">
    <table class="data-grid">
        <thead>
            <tr>
                <th>帳號</th>
                <th>電子郵件</th>
                <th>姓名</th>
                <th>狀態</th>
                <th>建立日期</th>
                <th>最後登入</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users.Count == 0)
            {
                <tr>
                    <td colspan="7" class="empty">查無符合條件的資料</td>
                </tr>
            }
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@(user.FullName ?? "-")</td>
                    <td class="center">
                        @if (user.IsActive)
                        {
                            <span class="status-active">啟用</span>
                        }
                        else
                        {
                            <span class="status-inactive">停用</span>
                        }
                    </td>
                    <td class="center">@user.CreatedDate.ToString("yyyy/MM/dd")</td>
                    <td class="center">@(user.LastLoginDate?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                    <td class="center">
                        <a asp-page="/Users/Edit" asp-route-id="@user.UserId">編輯</a>
                        |
                        @* 帳號放在 data-name，由 JavaScript 讀取，避免帳號內容被當成程式碼執行 *@
                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.UserId" class="inline-form"
                              data-name="@user.Username"
                              onsubmit="return confirm('確認要刪除使用者「' + this.dataset.name + '」嗎？此操作無法復原。');">
                            <input type="hidden" name="Query.Username" value="@Model.Query.Username" />
                            <input type="hidden" name="Query.Email" value="@Model.Query.Email" />
                            <input type="hidden" name="Query.FullName" value="@Model.Query.FullName" />
                            <input type="hidden" name="Query.IsActive" value="@Model.Query.IsActive?.ToString().ToLower()" />
                            <button type="submit" class="btn-link danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

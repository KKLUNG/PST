@*
    表單對話框：統一的欄位版面、資料驗證、儲存(Y)／取消(N) 按鈕
    在自訂的對話框元件 (實作 IDialogContentComponent) 中使用，以 BaseDialogService.ShowFormAsync 開啟
    - OnSave：驗證通過後呼叫，回傳 true 時關閉對話框
    - 鍵盤操作：欄位中按 Enter 跳到下一個欄位，最後一個欄位按 Enter 移到儲存按鈕
    用法 (UserEditDialog.razor)：
    <BaseFormDialog Model="model" OnSave="SaveAsync">
        <BaseField Label="帳號" Required="true"><BaseTextBox @bind-Value="model.Username" /></BaseField>
    </BaseFormDialog>
*@
<EditForm Model="@Model" OnValidSubmit="@SaveAsync" class="base-form-dialog base-keyboard-nav">
    <DataAnnotationsValidator />
    <div class="base-field-grid" style="--base-columns: @Columns">
        @ChildContent
    </div>
    <div class="base-button-bar">
        <BaseButton Text="@SaveText" Kind="BaseButtonKind.Primary" Icon="BaseIcon.Save"
                    ButtonType="ButtonType.Submit" Disabled="@saving" />
        <BaseButton Text="取消" Icon="BaseIcon.Cancel" OnClick="CancelAsync" Disabled="@saving" />
    </div>
</EditForm>

@code {
    [CascadingParameter] private FluentDialog? Dialog { get; set; }

    /// <summary>表單資料模型 (含 DataAnnotations 驗證屬性)</summary>
    [Parameter, EditorRequired] public object Model { get; set; } = default!;

    /// <summary>驗證通過後執行存檔，回傳 true 表示成功並關閉對話框</summary>
    [Parameter, EditorRequired] public Func<Task<bool>> OnSave { get; set; } = default!;

    /// <summary>表單欄位 (BaseField)</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>每列幾組欄位 (預設 2)</summary>
    [Parameter] public int Columns { get; set; } = 2;

    [Parameter] public string SaveText { get; set; } = "儲存";

    private bool saving;

    private async Task SaveAsync()
    {
        // 儲存中忽略重複送出 (避免連點造成重複新增)
        if (saving)
        {
            return;
        }

        saving = true;
        try
        {
            if (await OnSave() && Dialog is not null)
            {
                await Dialog.CloseAsync(true);
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (Dialog is not null)
        {
            await Dialog.CancelAsync();
        }
    }
}

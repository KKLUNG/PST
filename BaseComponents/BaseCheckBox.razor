@*
    核取方塊
    用法：<BaseCheckBox @bind-Value="model.IsActive" Label="啟用此使用者" />
*@
<div class="base-input-wrap base-checkbox-wrap">
    <FluentCheckbox Value="@Value"
                    ValueChanged="@ValueChanged"
                    ValueExpression="@ValueExpression"
                    Label="@Label"
                    ReadOnly="@ReadOnly"
                    Disabled="@Disabled"
                    Class="@($"base-checkbox {Class}".Trim())" />
    @if (ShowValidation)
    {
        <FluentValidationMessage For="@ValueExpression" Class="base-validation-message" />
    }
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool ShowValidation => EditContext is not null && ValueExpression is not null;
}

@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]
@*
    資料清單：統一的筆數顯示、工具列、分頁、無資料訊息與表格樣式
    欄位直接使用 MudBlazor 的 PropertyColumn / TemplateColumn
    用法：
    <BaseDataGrid Items="users" Loading="loading">
        <ToolBarContent><BaseButton Text="新增" AccessKey="A" OnClick="CreateAsync" /></ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Username" Title="帳號" />
            <TemplateColumn Title="操作">
                <CellTemplate>...context.Item...</CellTemplate>
            </TemplateColumn>
        </Columns>
    </BaseDataGrid>
*@
<div class="base-data-grid">
    <div class="base-grid-toolbar">
        <span class="base-grid-count">共 <strong>@(Items?.Count() ?? 0)</strong> 筆</span>
        <div class="base-grid-toolbar-buttons">@ToolBarContent</div>
    </div>

    <MudDataGrid T="T"
                 Items="@Items"
                 Columns="@Columns"
                 Loading="@Loading"
                 RowsPerPage="@(PageSize > 0 ? PageSize : int.MaxValue)"
                 Dense="true"
                 Striped="true"
                 Hover="true"
                 Bordered="true"
                 Elevation="0"
                 Filterable="false"
                 Breakpoint="Breakpoint.None"
                 HorizontalScrollbar="true"
                 Class="base-grid">
        <NoRecordsContent>
            <span class="base-grid-empty">@EmptyText</span>
        </NoRecordsContent>
        <LoadingContent>
            <span class="base-grid-empty">資料載入中...</span>
        </LoadingContent>
        <PagerContent>
            @if (PageSize > 0)
            {
                <MudDataGridPager T="T"
                                  PageSizeOptions="@PageSizeOptions"
                                  RowsPerPageString="每頁筆數："
                                  InfoFormat="第 {first_item}-{last_item} 筆，共 {all_items} 筆" />
            }
        </PagerContent>
    </MudDataGrid>
</div>

@code {
    [Parameter] public IEnumerable<T>? Items { get; set; }

    /// <summary>欄位定義 (PropertyColumn、TemplateColumn)</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>工具列右側內容，通常放新增按鈕</summary>
    [Parameter] public RenderFragment? ToolBarContent { get; set; }

    [Parameter] public bool Loading { get; set; }

    /// <summary>每頁筆數，0 表示不分頁</summary>
    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 20, 50, 100];

    [Parameter] public string EmptyText { get; set; } = "查無符合條件的資料";
}

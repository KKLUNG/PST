<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BaseComponents</RootNamespace>
    <Version>1.0.0</Version>
    <Description>共用底層 UI 元件庫（以 Microsoft Fluent UI Blazor 為基礎），統一各系統的輸入元件、查詢、表格、表單、對話框寫法與樣式</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- NuGet 套件依賴 -->
  <ItemGroup>
    <!-- Microsoft Fluent UI Blazor 元件庫 (底層元件皆以其為基礎包裝) -->
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.4" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.4" />
  </ItemGroup>

</Project>
